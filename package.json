{
  "name": "SayItBetter",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "postinstall": "node ./scripts/patch-react-native-tts-android.js",
    "setup:platforms": "bash ./scripts/setup-platforms.sh",
    "bundle-model": "bash ./scripts/bundle-model.sh",
    "download-llm-model": "bash ./scripts/download-llm-model.sh",
    "download-whisper-model": "bash ./scripts/download-whisper-model.sh",
    "bundle-whisper-model": "bash ./scripts/bundle-whisper-model.sh",
    "copy-model:ios": "bash ./scripts/copy-model-ios.sh",
    "copy-model:android": "bash ./scripts/copy-model-android.sh",
    "android:release": "npm run bundle-model && cd android && ./gradlew assembleRelease",
    "preandroid": "node -e \"const fs=require('fs');const p='android/app/src/main/assets/models/Qwen2.5-1.5B-Instruct-Q4_K_M.gguf';const w='android/app/src/main/assets/models/ggml-tiny.en.bin';if(!fs.existsSync(p)||!fs.existsSync(w)){console.warn('[SayItBetter] Bundled model(s) missing. Run once: npm run bundle-model');}\""
  },
  "dependencies": {
    "@fugood/react-native-audio-pcm-stream": "^1.1.4",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native/new-app-screen": "0.88.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "llama.rn": "^0.12.9",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^3.4.0",
    "react-native-gifted-charts": "^1.4.81",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-pixelflow": "^0.6.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.30.0",
    "react-native-svg": "^15.16.0",
    "react-native-tts": "^4.1.1",
    "whisper.rn": "^0.7.4"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@react-native/typescript-config": "0.88.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.3.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
